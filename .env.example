# ── Backend ──────────────────────────────────────────────────
# Which AI backend to use: ollama (local), google-ai, or openrouter
GEMMA_BACKEND=openrouter

# ── OpenRouter (recommended — free Gemma 4) ───────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Per-violation analysis: 31B dense — consistent structured output across many sequential calls
# OpenRouter only has the 31B dense for Gemma 4; MoE (26B) is not available there
OLLAMA_MODEL=google/gemma-4-31b-it:free

# Summarization model — same on OpenRouter (MoE unavailable), different on Ollama (gemma4:26b)
SUMMARY_MODEL=google/gemma-4-31b-it:free

# ── Google AI Studio (hosted Gemma) ──────────────────────────
# Get your key at: https://aistudio.google.com/apikey
# GEMMA_API_KEY=AIzaSy...

# ── Ollama (local / self-hosted) ─────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma4:latest
# OLLAMA_API_KEY=   # only if your remote Ollama requires auth
